# FixIt Agent API environment example.
# Copy to .env for local development. Never commit real credentials.

APP_NAME=FixIt Agent API
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
LOG_LEVEL=INFO

DATABASE_URL=postgresql://user:password@host:5432/database

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_VERIFICATION_MODE=auto
SUPABASE_STORAGE_BUCKET=ticket-attachments
SUPABASE_SIGNED_DOWNLOAD_TTL_SECONDS=300
MAX_TICKET_IMAGE_BYTES=10485760
ALLOWED_TICKET_IMAGE_MIME_TYPES=image/jpeg,image/png,image/webp
ENABLE_LEGACY_AGENT_ROUTES=false

ALLOW_LIVE_MIGRATION=false
RUN_SUPABASE_INTEGRATION_TESTS=false
SUPABASE_TEST_RESIDENT_ACCESS_TOKEN=
SUPABASE_TEST_BQL_ACCESS_TOKEN=

OPENAI_API_KEY=sk-your-key-here
MODEL_NAME=gpt-4o-mini
LLM_TEMPERATURE=0.7
CHROMA_PERSIST_DIR=./data/chroma

LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=fixit-agent
LANGCHAIN_TRACING_V2=true

AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=your-ai-log-key-here
AI_LOG_DIR=.ai-log
